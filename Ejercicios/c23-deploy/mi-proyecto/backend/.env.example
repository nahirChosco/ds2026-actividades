# --- Entorno ---
NODE_ENV=development
# En producción PORT lo inyecta Render: no se define
PORT=3000

# --- CORS ---
# URL exacta del front, sin barra final. En producción: https://TU-FRONT.onrender.com
FRONTEND_URL=http://localhost:5173

# --- Base de datos ---
# POSTGRES_* solo se usan en local, con Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_segura
POSTGRES_DB=libreria_db
POSTGRES_PORT=5432
# Local: host "db" de Compose. Producción: conexión directa (no pooled) de Neon, con ?sslmode=require
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Autenticación ---
# En producción se genera en el panel de Render. Nunca el real acá
JWT_SECRET=cambiame
# Vencimiento del token (si tu env.ts lo lee)
# JWT_EXPIRES_IN=2h

# --- Prisma ---
CHECKPOINT_DISABLE=1
PRISMA_HIDE_UPDATE_MESSAGE=1